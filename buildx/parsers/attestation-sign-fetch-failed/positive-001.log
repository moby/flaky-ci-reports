set -e

# Create temporary files
out_file=$(mktemp)
in_file=$(mktemp)
trap 'rm -f "$in_file" "$out_file"' EXIT
cat > "$in_file"

set -x

# Sign with cosign
cosign sign-blob \
  --yes \
  --oidc-provider github-actions \
  --new-bundle-format \
  --use-signing-config \
  --bundle "$out_file" \
  --tlog-upload=false \
  "$in_file"

# Output bundle to stdout
cat "$out_file"

