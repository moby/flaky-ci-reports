    INSTALL_K3S_EXEC: `--disable traefik --disable metrics-server --write-kubeconfig-mode 666 --write-kubeconfig ${kubeconfig}`,
  })
});

core.exportVariable('KUBECONFIG', kubeconfig);
await exec.exec(`yq ${kubeconfig}`);

